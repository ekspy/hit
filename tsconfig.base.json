{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@hit/repo-crdt": ["packages/repo-crdt/src/index.ts"],
      "@hit/semantic-indexer": ["packages/semantic-indexer/src/index.ts"],
      "@hit/impact-engine": ["packages/impact-engine/src/index.ts"],
      "@hit/coordinator": ["packages/coordinator/src/index.ts"],
      "@hit/agent": ["packages/agent/src/index.ts"],
      "@hit/eval": ["packages/eval/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
